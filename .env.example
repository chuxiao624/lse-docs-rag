# 阿里云百炼（DashScope）API key
# https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# LLSE 文档根目录（含 apis/、tutorials/、faq.zh.md、index.zh.md）
# 比如 clone 一份 LiteLDev/LegacyScriptEngine 后指向 docs 子目录
DOCS_ROOT=/path/to/docs

# 可选
# DASHSCOPE_EMBED_MODEL=text-embedding-v4
# DASHSCOPE_EMBED_DIM=2048
# DASHSCOPE_RERANK_MODEL=qwen3-rerank
# RAG_CACHE_SIZE=200
# WEB_PORT=5173
